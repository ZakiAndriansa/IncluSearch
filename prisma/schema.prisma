// OrtoPedagogik Connect — Prisma Schema
// Database: Neon PostgreSQL (serverless)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// AUTH (NextAuth v5 + Prisma Adapter)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

enum UserRole {
  PARENT
  EXPERT
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  password          String?   // hashed, null for OAuth
  role              UserRole  @default(PARENT)
  isPremium         Boolean   @default(false)
  premiumExpiresAt  DateTime?
  phone             String?
  bio               String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  expertProfile     ExpertProfile?
  assessments       Assessment[]
  consultationQuota ConsultationQuota?
  consultationsAsParent Consultation[] @relation("ParentConsultations")
  sentMessages      ChatMessage[]
  bookmarks         Bookmark[]
  payments          Payment[]
  knowledgeContents KnowledgeContent[]
  reviews           ExpertReview[]

  // NOTE: no @@index([email]) — the @unique on email already creates a btree.
  @@index([role])
}

// ─────────────────────────────────────────────
// EXPERT PROFILES
// ─────────────────────────────────────────────

enum SpecializationType {
  LEARNING_DIFFICULTIES
  BEHAVIORAL_SUPPORT
  COMMUNICATION_DISORDERS
  SENSORY_PROCESSING
  AUTISM_SPECTRUM
  ADHD
  DOWN_SYNDROME
  EMOTIONAL_REGULATION
  SOCIAL_SKILLS
  MOTOR_DEVELOPMENT
}

enum LocationType {
  ONLINE
  OFFLINE
  BOTH
}

model ExpertProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  specializations  SpecializationType[]
  bio              String               @db.Text
  education        String?
  certifications   String[]
  yearsExperience  Int                  @default(0)
  hourlyRate       Int                  // in IDR (rupiah)
  rating           Float                @default(0)
  totalReviews     Int                  @default(0)
  locationType     LocationType         @default(ONLINE)
  city             String?
  province         String?
  isVerified       Boolean              @default(false)
  isAvailable      Boolean              @default(true)
  profilePhotoUrl  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relations
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]
  consultations    Consultation[]       @relation("ExpertConsultations")
  matchScores      MatchScore[]
  reviews          ExpertReview[]
  personalAssessments PersonalAssessment[]
  payouts          Payout[]

  // Hot path: expert listing/search filters isVerified + isAvailable and sorts
  // by rating. This composite serves the filter and the sort in one index.
  @@index([isVerified, isAvailable, rating])
  @@index([rating])
  @@index([locationType])
}

model AvailabilitySlot {
  id           String        @id @default(cuid())
  expertId     String
  dayOfWeek    Int           // 0=Sun, 1=Mon, ..., 6=Sat
  startTime    String        // "09:00"
  endTime      String        // "17:00"
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  expert       ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
}

model ExpertReview {
  id           String        @id @default(cuid())
  expertId     String
  reviewerId   String
  rating       Int           // 1-5
  comment      String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  expert       ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  reviewer     User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([expertId, reviewerId]) // one review per user per expert
  @@index([expertId, createdAt])
  @@index([reviewerId])
}

// ─────────────────────────────────────────────
// ASSESSMENTS
// ─────────────────────────────────────────────

enum ChallengeType {
  LEARNING_DIFFICULTIES
  BEHAVIORAL_CHALLENGES
  COMMUNICATION_ISSUES
  SENSORY_PROCESSING
  SOCIAL_EMOTIONAL
  MULTIPLE_CHALLENGES
}

enum LearningEnvironment {
  HOME
  SCHOOL
  BOTH
  THERAPY_CENTER
}

model Assessment {
  id               String              @id @default(cuid())
  userId           String
  childName        String
  childAge         Int
  challengeType    ChallengeType
  challengeDetails String?             @db.Text
  learningEnv      LearningEnvironment
  goals            String[]
  locationPref     LocationType        @default(ONLINE)
  documentUrl      String?             // optional supporting PDF uploaded by the parent
  documentName     String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchScores      MatchScore[]
  personalAssessments PersonalAssessment[]

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────
// CONSULTATION QUOTA (free users)
// ─────────────────────────────────────────────

model ConsultationQuota {
  id                 String    @id @default(cuid())
  userId             String    @unique
  lastConsultationAt DateTime?
  nextAvailableAt    DateTime?
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// CONSULTATIONS
// ─────────────────────────────────────────────

enum ConsultationStatus {
  PENDING_PAYMENT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

model Consultation {
  id             String             @id @default(cuid())
  parentId       String
  expertId       String
  status         ConsultationStatus @default(PENDING_PAYMENT)
  scheduledAt    DateTime
  durationMins   Int                @default(60)
  paidAt         DateTime?
  completedAt    DateTime?
  sessionNotes   String?            @db.Text
  totalAmount    Int                // in IDR
  chatRoomId     String?            @unique
  videoCallUrl   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relations
  parent         User               @relation("ParentConsultations", fields: [parentId], references: [id])
  expert         ExpertProfile      @relation("ExpertConsultations", fields: [expertId], references: [id])
  chatRoom       ChatRoom?          @relation(fields: [chatRoomId], references: [id])
  payment        Payment?
  personalAssessment PersonalAssessment?

  // Composites match the real access patterns (parent history, expert agenda,
  // pending-booking guard) — they subsume the old single-column indexes.
  @@index([parentId, scheduledAt])
  @@index([expertId, scheduledAt])
  @@index([parentId, status])
  @@index([status])
}

// ─────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────

model ChatRoom {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())

  // Relations
  consultation  Consultation?
  messages      ChatMessage[]
  // NOTE: no @@index([id]) — the primary key already provides it.
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model ChatMessage {
  id         String      @id @default(cuid())
  roomId     String
  senderId   String
  content    String      @db.Text
  type       MessageType @default(TEXT)
  fileUrl    String?
  isRead     Boolean     @default(false)
  sentAt     DateTime    @default(now())

  // Relations
  room       ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id])

  @@index([roomId, sentAt])
}

// ─────────────────────────────────────────────
// KNOWLEDGE HUB
// ─────────────────────────────────────────────

enum ContentType {
  ARTICLE // tulisan biasa (text)
  VIDEO   // file video (upload)
  MODULE
  LINK    // tautan ke sumber eksternal
  PHOTO   // file foto (upload)
}

enum ContentCategory {
  LEARNING_DIFFICULTIES
  BEHAVIORAL_SUPPORT
  COMMUNICATION_DISORDERS
  SENSORY_PROCESSING
  PARENTING_TIPS
  EXPERT_GUIDES
  CASE_STUDIES
}

model KnowledgeContent {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  excerpt      String?         @db.Text
  content      String?         @db.Text
  type         ContentType
  category     ContentCategory
  isPremium    Boolean         @default(false)
  videoUrl     String?         // uploaded video (VIDEO) or embed URL
  thumbnailUrl String?
  externalUrl  String?         // target link (LINK)
  fileUrl      String?         // uploaded photo (PHOTO) / generic file
  ageRangeMin  Int?
  ageRangeMax  Int?
  readTimeMins Int?
  viewCount    Int             @default(0)
  publishedAt  DateTime?
  authorId     String?         // set when an expert authors the content
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  bookmarks    Bookmark[]
  author       User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // NOTE: no @@index([slug]) — the @unique on slug already creates a btree.
  @@index([type])
  @@index([category])
  @@index([publishedAt])
  @@index([publishedAt, isPremium])
  @@index([authorId])
}

// ─────────────────────────────────────────────
// PERSONAL ASSESSMENT (expert essay, completes the parent's initial assessment)
// ─────────────────────────────────────────────

enum PersonalAssessmentStatus {
  DRAFT
  SUBMITTED
}

model PersonalAssessment {
  id             String                   @id @default(cuid())
  consultationId String                   @unique
  expertId       String
  assessmentId   String?
  status         PersonalAssessmentStatus @default(DRAFT)

  // 3 sections × 3 questions (Kelebihan / Kekurangan / Kebutuhan)
  cognitiveStrength   String? @db.Text
  cognitiveWeakness   String? @db.Text
  cognitiveNeed       String? @db.Text
  socialStrength      String? @db.Text
  socialWeakness      String? @db.Text
  socialNeed          String? @db.Text
  psychomotorStrength String? @db.Text
  psychomotorWeakness String? @db.Text
  psychomotorNeed     String? @db.Text

  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  expert         ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  assessment     Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([expertId])
  @@index([assessmentId])
}

model Bookmark {
  id        String           @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   KnowledgeContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// COMMUNITY / FORUM DIRECTORY
// ─────────────────────────────────────────────

enum ABKFocusType {
  AUTISM
  ADHD
  DOWN_SYNDROME
  DYSLEXIA
  HEARING_IMPAIRMENT
  VISUAL_IMPAIRMENT
  CEREBRAL_PALSY
  INTELLECTUAL_DISABILITY
  MULTIPLE_DISABILITIES
  GENERAL_ABK
}

enum OrgType {
  FOUNDATION
  SCHOOL
  THERAPY_CENTER
  SUPPORT_GROUP
  GOVERNMENT
  NGO
}

model Community {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String         @db.Text
  focusAreas   ABKFocusType[]
  orgType      OrgType
  region       String
  province     String
  contactEmail String?
  contactPhone String?
  website      String?
  logoUrl      String?
  memberCount  Int            @default(0)
  isVerified   Boolean        @default(false)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([province])
  @@index([orgType])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// MATCHING SCORES
// ─────────────────────────────────────────────

model MatchScore {
  id           String        @id @default(cuid())
  assessmentId String
  expertId     String
  score        Float         // 0-100
  reasons      String[]
  breakdown    Json?         // { specialization: 40, challengeType: 30, ... }
  createdAt    DateTime      @default(now())

  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  expert       ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, expertId])
  @@index([assessmentId])
  @@index([score])
}

// ─────────────────────────────────────────────
// EXPERT PAYOUTS (manual settlement records)
// ─────────────────────────────────────────────

model Payout {
  id        String        @id @default(cuid())
  expertId  String
  amount    Int           // net amount paid to the expert, in IDR
  method    String?       // e.g. "Transfer Bank"
  note      String?
  createdAt DateTime      @default(now())

  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId, createdAt])
}

// ─────────────────────────────────────────────
// PAYMENTS (Midtrans)
// ─────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  CONSULTATION
  PREMIUM_SUBSCRIPTION
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  consultationId   String?       @unique
  type             PaymentType
  amount           Int           // in IDR
  status           PaymentStatus @default(PENDING)
  midtransOrderId  String        @unique
  midtransToken    String?
  midtransUrl      String?
  paidAt           DateTime?
  expiresAt        DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  user             User          @relation(fields: [userId], references: [id])
  consultation     Consultation? @relation(fields: [consultationId], references: [id])

  // NOTE: no @@index([midtransOrderId]) — the @unique already creates a btree.
  @@index([userId, type, createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────
// LANDING PAGE CMS (singleton)
// ─────────────────────────────────────────────

// One row (id = "landing") holding all editable landing-page content as JSON.
// Admin edits it via /admin/landing; the public page merges it over the code
// defaults in lib/landing.ts, so an empty/absent row renders the defaults.
model LandingContent {
  id        String   @id @default("landing")
  data      Json
  updatedAt DateTime @updatedAt
}
