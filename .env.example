# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-at-least-32-chars

# ─────────────────────────────────────────────
# Database — Neon PostgreSQL
# Get these from: https://neon.tech
# Use the "pooled connection" URL for DATABASE_URL
# Use the "direct connection" URL for DIRECT_URL
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/ortoconnect?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/ortoconnect?sslmode=require

# ─────────────────────────────────────────────
# Google OAuth
# Get from: https://console.cloud.google.com
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────
# Midtrans Payment Gateway
# Get from: https://dashboard.midtrans.com (Settings → Access Keys)
#
# Environment is auto-detected from the KEY PREFIX — no separate flag:
#   • Sandbox    : SB-Mid-server-xxxx / SB-Mid-client-xxxx   (for development)
#   • Production : Mid-server-xxxx    / Mid-client-xxxx      (real money!)
# Tip: keep SANDBOX keys locally (.env.local) and set PRODUCTION keys only on
# the deployment (Vercel), so local testing never charges real cards.
#
# Production also requires:
#   • NEXTAUTH_URL = your https domain (used for notification_url + callbacks)
#   • Register the webhook in the Midtrans dashboard
#     (Settings → Configuration → Payment Notification URL):
#       https://<your-domain>/api/payments/webhook
# ─────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx

# ─────────────────────────────────────────────
# Vercel Blob Storage (for file uploads)
# Auto-configured when using Vercel Blob
# ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ─────────────────────────────────────────────
# Pusher (Real-time chat — optional)
# Get from: https://pusher.com
# ─────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
